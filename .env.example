# Server-only settings for the app's API routes (src/app/api). Copy to .env.local for development,
# and set the same names on the host (Vercel or EAS). NEVER prefix these with EXPO_PUBLIC_.

# Same database as the HomeBridge website
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=homebridge

# Signs sign-in tokens. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
MEMBER_SESSION_SECRET=

# Encrypts uploaded ID photos and proof of address. MUST be the same value as the website's
# DOCUMENTS_KEY, or officers won't be able to open files uploaded in the app.
DOCUMENTS_KEY=

# Optional: email the office when an applicant replies in the app (same as the website's settings)
RESEND_API_KEY=
EMAIL_FROM=
OFFICE_ALERT_EMAIL=
# Optional, same as the website: where replies go, a hidden copy, and the website address for admin links.
EMAIL_REPLY_TO=
EMAIL_BCC=
SITE_URL=
